{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch|create_file|replace_string_in_file|multi_replace_string_in_file",
        "type": "command",
        "command": "python3 .github/hooks/guard-worktree-drift.py",
        "timeout": 5
      },
      {
        "matcher": "Edit|Write|apply_patch|create_file|replace_string_in_file|multi_replace_string_in_file",
        "type": "command",
        "command": "python3 .github/hooks/guard-main-branch.py",
        "timeout": 5
      },
      {
        "matcher": "Bash",
        "type": "command",
        "command": "python3 scripts/hooks/guard-bash-main-branch.py",
        "timeout": 5
      },
      {
        "matcher": "Bash",
        "type": "command",
        "command": "python3 scripts/hooks/terminal-guard.py",
        "timeout": 5
      },
      {
        "matcher": "Edit|Write",
        "type": "command",
        "command": "python3 scripts/hooks/guard-task-plan-findings.py",
        "timeout": 5
      },
      {
        "matcher": "mcp_altcontext-mc_record_event|mcp_altcontext-mc_close_slice|mcp__workstate-handoff-mcp__record_event|mcp__workstate-handoff-mcp__close_slice|mcp__agent-handoff-mcp__record_event|mcp__agent-handoff-mcp__close_slice",
        "type": "command",
        "command": "python3 scripts/hooks/guard-rationale-size.py",
        "timeout": 5
      },
      {
        "matcher": "mcp_altcontext-mc_record_event|mcp_altcontext-mc_review_findings|mcp_altcontext-mc_review_runs|mcp__workstate-handoff-mcp__record_event|mcp__workstate-handoff-mcp__review_findings|mcp__workstate-handoff-mcp__review_runs|mcp__agent-handoff-mcp__record_event|mcp__agent-handoff-mcp__review_findings|mcp__agent-handoff-mcp__review_runs",
        "type": "command",
        "command": "python3 scripts/hooks/validate-mcp-dict-params.py",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/record-file-touch.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp_altcontext-mc_review_findings|mcp__workstate-handoff-mcp__review_findings|mcp__agent-handoff-mcp__review_findings",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/ace-detect.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp_altcontext-mc_get_handoff_state|mcp_altcontext-mc_load_session|mcp_altcontext-mc_render_handoff|mcp__workstate-handoff-mcp__get_handoff_state|mcp__workstate-handoff-mcp__load_session|mcp__workstate-handoff-mcp__render_handoff|mcp__agent-handoff-mcp__get_handoff_state|mcp__agent-handoff-mcp__load_session|mcp__agent-handoff-mcp__render_handoff",
        "type": "command",
        "command": "python3 scripts/hooks/slim-handoff-response.py",
        "timeout": 5
      },
      {
        "matcher": "Bash",
        "type": "command",
        "command": "python3 scripts/hooks/filter-test-output.py",
        "timeout": 5
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 scripts/hooks/advise-worktree-cd.py",
        "timeout": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "python3 scripts/hooks/advise-worktree-cd.py",
        "timeout": 5
      }
    ]
  }
}
